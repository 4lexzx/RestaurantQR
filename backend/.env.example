PORT=4000
AUTH_SECRET=genera_un_secreto_largo_y_unico_para_cada_entorno
POLLINATIONS_API_KEY=
NODE_ENV=development

# PostgreSQL LOCAL (copiar a .env y ajustar password)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Menu_Go
DB_USER=postgres
DB_PASSWORD=tu_password
# Cuenta privilegiada: únicamente migraciones, resolución de tenants y SuperAdmin.
DB_USER_ADMIN=postgres
DB_PASS_ADMIN=tu_password
# Cuenta de aplicación sin SUPERUSER ni BYPASSRLS. Debe usarse en todos los
# paneles de restaurante para que PostgreSQL aplique el aislamiento SaaS.
DB_USER_APP=menugo_app
DB_PASS_APP=tu_password_app
DB_USER_MESERO=menugo_app
DB_PASS_MESERO=tu_password_app
DB_USER_COCINA=menugo_app
DB_PASS_COCINA=tu_password_app
DB_USER_CLIENTE=menugo_app
DB_PASS_CLIENTE=tu_password_app
PGSSLMODE=disable

//frontend
FRONTEND_URL=http://localhost:5500
FRONTEND_URLS=http://localhost:5500,http://localhost:4000
# Secreto largo y aleatorio para firmar sesiones (obligatorio en producción)
AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-48-caracteres
AUTH_TOKEN_TTL_SECONDS=28800
